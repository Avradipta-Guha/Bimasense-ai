# ==============================================================================
# BimaSense AI — Environment Configuration Template
# Copy this file to .env and fill in your Groq API key (free at console.groq.com)
# ==============================================================================

APP_NAME="BimaSense AI Backend"
APP_ENV="development"
DEBUG=true

# --- Primary Free-Tier LLM (Groq Cloud - High Accuracy & Ultra-Low Latency) ---
# Recommended primary model: llama-3.3-70b-versatile
# Recommended reasoning/structured fallback on Groq: qwen-2.5-32b
GROQ_API_KEY="gsk_your_free_groq_api_key_here"
PRIMARY_LLM_MODEL="llama-3.3-70b-versatile"
SECONDARY_LLM_MODEL="qwen-2.5-32b"
LLM_TEMPERATURE=0.0

# --- Local Fallback LLM (Ollama) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_FALLBACK_MODEL="qwen2.5:7b-instruct"

# --- Qdrant Vector Database (Local Docker or Qdrant Cloud Free Tier) ---
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_USE_IN_MEMORY_FALLBACK=true

# --- Hybrid Retrieval & Reranking Models ---
DENSE_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
DENSE_EMBEDDING_DIM=384
SPARSE_EMBEDDING_MODEL="Qdrant/bm25"
RERANKER_MODEL="ms-marco-MiniLM-L-12-v2"
RETRIEVAL_TOP_K=15
RERANK_TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.35
